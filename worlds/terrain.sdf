<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="terrain">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <!-- Slightly darker ambient + sky-like background for more realistic camera frames -->
      <ambient>0.28 0.29 0.30 1</ambient>
      <background>0.60 0.72 0.88 1</background>
      <shadows>true</shadows>
      <!-- Subtle haze adds depth and reduces "flat" look (keep it light for dataset clarity) -->
      <fog>
        <type>linear</type>
        <color>0.60 0.72 0.88 1</color>
        <start>180</start>
        <end>1200</end>
        <density>0.002</density>
      </fog>
      <sky>
        <clouds>
          <speed>8</speed>
        </clouds>
      </sky>
    </scene>

    <gui fullscreen='0'>
      <plugin name='3D View' filename='GzScene3D'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <!-- Keep GUI preview consistent with <scene> for nicer frames -->
        <ambient_light>0.28 0.29 0.30</ambient_light>
        <background_color>0.60 0.72 0.88</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>
      <plugin name='World control' filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='width'>121</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='anchor'>bottom</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin name='World stats' filename='WorldStats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
          <property type='double' key='height'>110</property>
          <property type='double' key='width'>290</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='anchor'>bottom_left</property>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin name='Entity tree' filename='EntityTree'>
        <gz-gui>
          <property key='state' type='string'>docked</property>
          <property key='showTitleBar' type='bool'>true</property>
          <property key='width' type='double'>300</property>
          <property key='height' type='double'>420</property>
          <property key='anchor' type='string'>right</property>
        </gz-gui>
      </plugin>
      <plugin name='Transform control' filename='TransformControl'>
        <gz-gui>
          <title>Transform control</title>
          <property key='state' type='string'>docked</property>
          <property key='showTitleBar' type='bool'>true</property>
          <property key='width' type='double'>300</property>
          <property key='height' type='double'>120</property>
          <property key='anchor' type='string'>right</property>
        </gz-gui>
      </plugin>
      <plugin name='Component inspector' filename='ComponentInspector'>
        <gz-gui>
          <title>Component inspector</title>
          <property key='state' type='string'>docked</property>
          <property key='showTitleBar' type='bool'>true</property>
          <property key='width' type='double'>300</property>
          <property key='height' type='double'>260</property>
          <property key='anchor' type='string'>right</property>
        </gz-gui>
      </plugin>
      <plugin name='Drone Camera' filename='ImageDisplay'>
        <gz-gui>
          <property key='state' type='string'>floating</property>
          <property key='width' type='double'>400</property>
          <property key='height' type='double'>300</property>
          <property key='y' type='double'>0</property>
          <property key='x' type='double'>0</property>
          <property key='showTitleBar' type='bool'>true</property>
        </gz-gui>
        <topic>/rgb_camera/image</topic>
      </plugin>
    </gui>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <!-- Lower sun angle gives longer, more informative shadows for detection -->
      <direction>0.10 0.40 -0.60</direction>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <!-- Tune shadow quality without going too heavy -->
      <shadow_caster>
        <near_clip>2</near_clip>
        <far_clip>1500</far_clip>
      </shadow_caster>
    </light>

    <!-- Low-cost fill light to soften contrast (no shadows) -->
    <light name="fill_light" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.22</intensity>
      <direction>-0.30 -0.20 -0.80</direction>
      <diffuse>0.75 0.80 0.90 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Terrain -->
    <include>
      <name>city_terrain_1</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://city_terrain_hq</uri>
    </include>

    <!-- Ocean at water level -->
    <include>
      <name>ocean_2</name>
      <pose>40 -20 -2 0 0 0</pose>
      <uri>model://ocean</uri>
    </include>

    <!--
      Dataset anchor:
      If terrain / ground level changes, update ONLY this pose (especially Z).
      All target and clutter objects are placed relative to this anchor.
    -->
    <frame name="dataset_anchor">
      <pose>15.19 -197.69 2.29 0 0 0</pose>
    </frame>

